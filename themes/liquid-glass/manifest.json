{
  "manifest_version": 3,
  "name": "ThemePark — Liquid Glass",
  "version": "2.0.0",
  "description": "Companion browser-chrome theme for the ThemePark extension: macOS Sonoma-style wallpaper, gradient-matched chrome, frosted surfaces. Static by design — browser UI cannot be scripted.",
  "theme": {
    "images": {
      "theme_frame": "assets/frame.png",
      "theme_frame_inactive": "assets/frame-inactive.png",
      "theme_ntp_background": "assets/wallpaper.png"
    },
    "colors": {
      "frame": [34, 69, 110],
      "frame_inactive": [40, 42, 72],
      "frame_incognito": [34, 69, 110],
      "frame_incognito_inactive": [40, 42, 72],
      "background_tab": [26, 47, 78],
      "background_tab_inactive": [24, 42, 70],
      "background_tab_text": [148, 155, 170],
      "toolbar": [34, 69, 110],
      "toolbar_button_icon": [205, 210, 220],
      "toolbar_text": [245, 245, 247],
      "bookmark_text": [245, 245, 247],
      "tab_background_text": [148, 155, 170],
      "tab_text": [245, 245, 247],
      "omnibox_background": [255, 255, 255, 26],
      "omnibox_text": [245, 245, 247],
      "ntp_background": [34, 69, 110],
      "ntp_text": [245, 245, 247],
      "ntp_link": [140, 180, 255],
      "button_background": [255, 255, 255, 22]
    },
    "tints": {
      "buttons": [-1, -1, 0.85],
      "frame_inactive": [-1, -1, 0.92],
      "background_tab": [-1, -1, 0.92]
    },
    "properties": {
      "ntp_background_alignment": "bottom"
    }
  }
}

---
import Base from '../layouts/Base.astro';

// Stable-download contract: the release workflow publishes EVERY version with
// the asset name `ThemePark-chrome.zip`, so this URL never goes stale.
// (If the asset is missing — e.g. before the first release — GitHub 404s;
//  the release workflow in .github/workflows/release.yml is the guarantee.)
const INSTALL_URL =
  'https://github.com/D1bakar/Theme-park/releases/latest/download/ThemePark-chrome.zip';
const RELEASES_URL = 'https://github.com/D1bakar/Theme-park/releases';
const THEME_URL =
  'https://github.com/D1bakar/Theme-park/releases/latest/download/ThemePark-liquid-glass-theme.zip';

const controls = [
  {
    title: 'True black',
    body: 'AMOLED antireflective — #000000 on the page and its panels, so OLED pixels emit nothing. Not dark gray: black.',
  },
  {
    title: 'Anti-glare',
    body: 'Text adapts to the light around you — dim at night, brighter in daylight. Images dim to match, and no page ever flashes white on load.',
  },
  {
    title: 'Comfort',
    body: 'Text size, line height and reading width steppers. One switch to calm every animation on the web.',
  },
];

const steps = [
  'Download the zip with the button above.',
  'Unzip it anywhere you like — it is a plain folder.',
  'Open <code>chrome://extensions</code>, enable <strong>Developer mode</strong>, then click <strong>Load unpacked</strong> and pick the folder.',
];

const browserThemeSteps = [
  'Open <code>chrome://extensions</code> with Developer mode on.',
  'Click <strong>Load unpacked</strong> and pick the unzipped theme folder.',
  'Your tabs, toolbar and new-tab page go dark to match. Pages are handled by the extension itself.',
];
---

<Base
  title="ThemePark — AMOLED antireflective dark for Chrome & Brave"
  description="One extension, one theme: AMOLED antireflective dark. True black, glare-aware text, dimmed images, no white flash. Typography and animation controls included. All settings local — nothing leaves your device."
>
  <section class="hero">
    <p class="eyebrow">Chrome · Brave · Manifest V3</p>
    <h1>One theme. AMOLED antireflective.</h1>
    <p class="hero-tagline">
      A matte screen for your eyes: true black everywhere, text that adapts to the
      light around you, images dimmed, no white flash on load. Load it once — every
      site you visit goes dark. Every setting stays on your device.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href={INSTALL_URL} download>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"></path>
        </svg>
        Install ThemePark
      </a>
      <a class="btn btn-ghost" href="https://github.com/D1bakar/Theme-park" rel="noopener">View source</a>
    </div>
    <p class="cta-note">Free, open source. No account, no tracking, no data collection. <a href={RELEASES_URL} rel="noopener">All releases →</a></p>
  </section>

  <p class="section-label">What it does</p>
  <div class="grid-3">
    {controls.map((c) => (
      <article class="card">
        <h3>{c.title}</h3>
        <p>{c.body}</p>
      </article>
    ))}
  </div>

  <p class="section-label" id="install">Install in three steps</p>
  <div class="card">
    <ol class="steps">
      {steps.map((s) => <li set:html={s} />)}
    </ol>
    <p style="margin: 14px 0 0; font-size: 13px;">
      Works on Chrome and Brave (and most Chromium browsers). Not on Firefox or Safari yet.
    </p>
  </div>

  <p class="section-label" id="themes">Optional: the browser chrome, too</p>
  <div class="grid-2">
    <article class="card">
      <div class="swatch">
        <div class="swatch-dots" aria-hidden="true">
          <span style="background: #000000;" />
          <span style="background: #0a0a0a;" />
          <span style="background: #d4d4d4;" />
        </div>
        <div style="min-width:0;">
          <h3 style="margin-bottom: 2px;">Browser theme pack</h3>
          <p style="font-size: 13.5px;">Tabs, toolbar and new-tab page go dark to match the extension. Static by design — browser UI can't be scripted.</p>
        </div>
      </div>
      <a class="btn btn-ghost" style="margin-top: 12px; font-size: 13px; padding: 7px 14px;" href={THEME_URL} download>
        Download theme pack
      </a>
    </article>
    <article class="card">
      <h3>Why one theme?</h3>
      <p>ThemePark used to be a theme gallery. We picked the one worth using and made it excellent: pure black, anti-glare, zero lag, zero weird behaviour. One switch, everything dark, everywhere.</p>
    </article>
  </div>

  <p class="section-label">How to apply the browser theme (optional)</p>
  <div class="card">
    <ol class="steps">
      {browserThemeSteps.map((s) => <li set:html={s} />)}
    </ol>
  </div>
</Base>
